# AI Finance Advisor - Backend Environment Configuration Example
APP_NAME=AI Finance Advisor
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL in production, SQLite async in development/tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_finance_db
# Alternative for local development: DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# Security & JWT Configuration (Deferred to Phase 7C)
JWT_SECRET=your_super_secret_production_key_here_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
