# Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.

# FastAPI Backend Base URL (Used when connecting to real backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Toggle between local mock services (true) and FastAPI backend HTTP requests (false)
VITE_USE_MOCK_API=true
